# syntax=docker/dockerfile:1

FROM php:8.4-fpm-bookworm AS php-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx supervisor cron git unzip libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev \
        libfreetype6-dev libc-client2007e-dev libkrb5-dev libssl-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath gd intl mysqli pdo_mysql zip opcache \
    && pecl install imap-1.0.3 \
    && docker-php-ext-enable imap \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf 'memory_limit=512M\nupload_max_filesize=64M\npost_max_size=64M\n' > "$PHP_INI_DIR/conf.d/hubleto.ini" \
    && printf '\nphp_admin_flag[display_errors] = off\n' >> /usr/local/etc/php-fpm.d/www.conf
WORKDIR /var/www/hubleto

FROM php-base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY composer.* ./
RUN COMPOSER_ALLOW_SUPERUSER=1 composer install \
    --no-dev --prefer-dist --no-interaction --no-progress --no-autoloader \
    && test -s vendor/hubleto/assets/compiled/js/main.js \
    && test -s vendor/hubleto/assets/compiled/css/main.css
COPY . .
RUN COMPOSER_ALLOW_SUPERUSER=1 composer dump-autoload --no-dev --optimize

FROM php-base AS app
COPY --from=dependencies --chown=www-data:www-data /var/www/hubleto /var/www/hubleto
COPY docker/nginx.conf /etc/nginx/conf.d/hubleto.conf
# Match the bootstrap files generated by the installed Hubleto version.
RUN for script in boot index cron; do \
        cp "vendor/hubleto/erp/installer/Templates/$script.php.tpl" "$script.php"; \
    done \
    && ln -s /var/lib/hubleto/ConfigEnv.php ConfigEnv.php \
    && rm -f /etc/nginx/sites-enabled/default \
    && printf '%s\n' '* * * * * www-data cd /var/www/hubleto && /usr/local/bin/php cron.php >> /var/www/hubleto/log/cron-output.log 2>&1' > /etc/cron.d/hubleto \
    && mkdir -p /var/lib/hubleto/secure /var/www/hubleto/upload /var/www/hubleto/log \
    && chown www-data:www-data /var/www/hubleto \
    && chown -R www-data:www-data /var/lib/hubleto /var/www/hubleto/upload /var/www/hubleto/log
RUN <<'SH'
cat > /etc/supervisor/conf.d/hubleto.conf <<'CONF'
[program:php-fpm]
command=/usr/local/sbin/php-fpm -F
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nginx]
command=/usr/sbin/nginx -g "daemon off;"
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:cron]
command=/usr/sbin/cron -f
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
CONF
SH

EXPOSE 80
# First-start setup uses the client's database and environment; subsequent starts keep the installation.
CMD ["sh", "-ec", "mkdir -p /var/lib/hubleto/secure /var/www/hubleto/upload /var/www/hubleto/log; chown www-data:www-data /var/lib/hubleto /var/lib/hubleto/secure /var/www/hubleto/upload /var/www/hubleto/log; runuser -u www-data -- php docker/init.php; ln -sf /var/lib/hubleto/ConfigEnv.php ConfigEnv.php; exec supervisord -n -c /etc/supervisor/supervisord.conf"]
